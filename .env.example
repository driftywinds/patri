# Base URL of your d9 (Directus fork) instance. https only, except localhost.
DIRECTUS_URL=https://d9.example.com
DIRECTUS_TOKEN=
# Shared key for /admin; at least 32 characters or admin stays disabled.
# Generate one: openssl rand -hex 32
ADMIN_TOKEN=
# Set to 1 only when a proxy you control is the single way in.
TRUSTED_PROXY=0
# How many NTES calls may run at once.
NTES_CONCURRENCY=4
CACHE_TTL=900
HOST=0.0.0.0
PORT=8000
